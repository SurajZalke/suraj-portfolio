# ─────────────────────────────────────────────
# SendGrid Configuration (GitHub Student Pack)
# 1. Claim offer at: https://education.github.com/pack  → search "SendGrid"
# 2. Create account at sendgrid.com using your student email
# 3. Go to Settings → API Keys → Create API Key (Full Access)
# 4. Go to Settings → Sender Authentication → verify your sending email
# ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=your-verified-sender@gmail.com   # must match verified sender in SendGrid

# Who receives contact form messages
OWNER_EMAIL=surajzalke724@gmail.com

# ─────────────────────────────────────────────
# Twilio Configuration (WhatsApp) - OPTIONAL
# GitHub Student Pack gives $50 free Twilio credits
# 1. Claim at: https://education.github.com/pack → search "Twilio"
# 2. Log in at console.twilio.com with your student account
# 3. Copy Account SID and Auth Token from the dashboard
# 4. Enable WhatsApp Sandbox: Messaging → Try it out → Send a WhatsApp message
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number (or your purchased number)

# Server Configuration
PORT=3001
NODE_ENV=production
